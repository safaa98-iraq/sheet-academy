APP_NAME="Sheet Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8081

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
TRUSTED_PROXIES=
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sheet_academy
DB_USERNAME=root
DB_PASSWORD=
# للتطوير باستخدام SQLite بدلاً من MySQL: DB_CONNECTION=sqlite و DB_DATABASE=/absolute/path/database/database.sqlite

# استخدم تخزين قاعدة البيانات للجلسات والكاش وقائمة المهام بعد تشغيل migrations.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# خدمة معالجة الفيديو Node.js. استخدم قيمة عشوائية طويلة واحدة في Laravel وvideo-worker.
VIDEO_WORKER_URL=http://127.0.0.1:3300
VIDEO_WORKER_TOKEN=

# المرحلة 5: الأجهزة، التنبيهات، وتعهد استخدام المحتوى
STUDENT_DEVICE_LIMIT=1
AUDIT_ALERT_THRESHOLD=3
AUDIT_AUTO_SUSPEND_SCORE=0
AUDIT_EMAIL_ENABLED=false
CONTENT_AGREEMENT_VERSION=2026-10-v1
PDFINFO_BINARY=pdfinfo
PDFTOPPM_BINARY=pdftoppm
LESSON_COMPLETION_THRESHOLD=0.9
LESSON_PROGRESS_HEARTBEAT_SECONDS=12
LESSON_PROGRESS_MAX_HEARTBEAT_GAP_SECONDS=25
DOCUMENT_MAX_PAGES=60
DOCUMENT_PAGE_TTL_HOURS=24

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# بيانات حساب الأستاذ الأول عند تشغيل php artisan db:seed؛ عيّن كلمة مرور خاصة من 12 حرفاً على الأقل.
SUPERADMIN_NAME="د. سليم"
SUPERADMIN_EMAIL=professor@example.test
SUPERADMIN_PASSWORD=
